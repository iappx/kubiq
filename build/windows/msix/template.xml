<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="kubiq"
        Arguments=""
        InstallLocation="C:\Program Files\IAPPX\kubiq">
    </Installer>
    <PackageInformation
        PackageName="kubiq"
        PackageDisplayName="kubiq"
        PublisherName="CN=IAPPX"
        PublisherDisplayName="IAPPX"
        Version="0.1.0.0"
        PackageDescription="Kubernetes cluster management console">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="Kubiq"
                Description="Kubernetes cluster management console"
                DisplayName="kubiq"
                ExecutableName="kubiq"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>kubiq</DisplayName>
            <PublisherDisplayName>IAPPX</PublisherDisplayName>
            <Description>Kubernetes cluster management console</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="kubiq.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
