# Copy to `.env` (defaults) and `.env.development` (local overrides).
# Both are gitignored. Everything here is inlined into the bundle at build time —
# never put a secret in a VITE_ variable.

# Display name of the application (logo, window title)
VITE_APP_NAME=kubiq

# Documentation link (empty — the header button is hidden)
VITE_APP_DOCS_URL=

# Dev server port. Must match VITE_PORT in the root Taskfile.yml.
VITE_DEV_PORT=9245
